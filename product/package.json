{
  "name": "@yld-cx/product",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "turbo run build:app",
    "start": "next start",
    "typecheck": "turbo run typecheck:app",
    "lint": "eslint .",
    "validate:registry": "node --import tsx scripts/sync-abi.ts --check && node --import tsx scripts/validate-registry.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "turbo run typecheck:app lint test build:app",
    "sync:abi": "node --import tsx scripts/sync-abi.ts",
    "test:deployments": "node --import tsx scripts/smoke-deployments.ts",
    "format": "prettier --write .",
    "ui:add": "shadcn add --cwd packages/ui",
    "build:app": "next build --webpack",
    "typecheck:app": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "4.4.0",
    "@safe-global/safe-apps-provider": "0.18.6",
    "@safe-global/safe-apps-sdk": "9.1.0",
    "@tanstack/react-query": "5.104.2",
    "@walletconnect/ethereum-provider": "2.26.0",
    "@yld-cx/sdk": "1.0.0",
    "@yld-cx/ui": "1.0.0",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "sharp": "0.35.5",
    "viem": "2.57.6",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@yld-cx/ethereum-protocol": "0.3.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.10",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "turbo": "2.9.18",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "packageManager": "npm@12.0.2"
}
