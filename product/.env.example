# Browser-visible RPC URLs: use provider-restricted public credentials only.
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional. No project ID gracefully disables mobile WalletConnect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional read-only deployment smoke test; no private keys are used.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ROBINHOOD_RPC_URL=
# Infra data worker
CLOUDFLARE_ACCOUNT_ID=
YLD_D1_DATABASE_ID=
YLD_D1_READ_TOKEN=
