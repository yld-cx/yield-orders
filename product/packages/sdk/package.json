    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@yld-cx/ethereum-protocol": "0.3.1",
    "viem": "2.57.6",
    "zod": "4.6.7"
  }
