{
  "name": "@yld-cx/sdk",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ethereum": {
      "types": "./dist/ethereum/index.d.ts",
      "default": "./dist/ethereum/index.js"
    },
