{
  "name": "yld-resolver",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/5 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "CHAINS", "class_name": "ChainCoordinator" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChainCoordinator"] }],
  "vars": {
    "RESOLVER_ENABLED": "false",
    "DRY_RUN": "true",
    "NETWORKS": "[\"base\"]",
    "RPC_URLS": "{\"ethereum\":[\"https://ethereum-rpc.publicnode.com\",\"https://gateway.tenderly.co/public/mainnet\"],\"base\":[\"https://mainnet.base.org\",\"https://base-rpc.publicnode.com\"],\"robinhood\":[\"https://rpc.mainnet.chain.robinhood.com\",\"https://robinhood-rpc.publicnode.com\"]}",
    "MARKETS_API_ORIGIN": "https://yld.cx",
    "MAX_MARKETS_PER_RUN": "25",
    "MAX_CANDIDATES_PER_MARKET": "8",
    "MAX_BATCH": "8",
    "MAX_RUN_DURATION_MS": "120000",
    "MAX_QUOTE_REQUESTS": "40",
    "MAX_DISCOVERY_RADIUS": "4",
    "MAX_REFERENCE_PRICE_IMPACT_PERCENT": "0.1",
    "MIN_EXPECTED_NET_USD": "1",
    "MAX_SLIPPAGE_PERCENT": "0.5",
  },
}
