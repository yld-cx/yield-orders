{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yld-resolver",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "CHAINS", "class_name": "ChainCoordinator" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChainCoordinator"] }],
  "vars": {
    "RESOLVER_ENABLED": "true",
    "DRY_RUN": "false",
    "NETWORKS": "[\"base\"]",
    "RPC_URLS": "{\"ethereum\":[\"https://ethereum-rpc.publicnode.com\",\"https://gateway.tenderly.co/public/mainnet\"],\"base\":[\"https://base-rpc.publicnode.com\",\"https://mainnet.base.org\"],\"robinhood\":[\"https://robinhood-rpc.publicnode.com\",\"https://rpc.mainnet.chain.robinhood.com\"]}",
    "MARKETS_API": "https://yld.cx/api/markets",
  },
  "secrets": {
    "required": ["UNISWAP_API_KEY", "RESOLVER_SIGNING_KEY"],
  },
}
