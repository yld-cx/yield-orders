{
  "name": "yld-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "setup": "npm ci --prefix ../../../product && npm ci --prefix ../../../skills && npm run build --prefix ../../../skills && npm ci",
    "dev": "wrangler dev",
    "types": "wrangler types .wrangler/worker-configuration.d.ts --include-runtime false",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run typecheck && npm test && npm run build && npm run test:runtime",
    "test:runtime": "node --test test/runtime.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@yld-cx/sdk": "file:../../../product/packages/sdk",
    "@yld-cx/skills": "file:../../../skills",
    "viem": "2.57.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^24.0.0",
    "miniflare": "^5.20261110.1-beta",
    "typescript": "6.0.3",
    "wrangler": "4.160.1"
  }
}
