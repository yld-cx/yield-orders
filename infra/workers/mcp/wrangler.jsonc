{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yld-mcp",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "mcp.yld.cx", "custom_domain": true }],
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMIT",
      "namespace_id": "8453001",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "SIGNER_RATE_LIMIT",
      "namespace_id": "8453002",
      "simple": { "limit": 8, "period": 60 },
    },
  ],
  "vars": {
    "EXECUTION_ENABLED": "false",
    "RPC_URLS": "{\"ethereum\":[\"https://ethereum-rpc.publicnode.com\",\"https://gateway.tenderly.co/public/mainnet\"],\"base\":[\"https://base-rpc.publicnode.com\",\"https://mainnet.base.org\"],\"robinhood\":[\"https://robinhood-rpc.publicnode.com\",\"https://rpc.mainnet.chain.robinhood.com\"]}",
  },
  "secrets": { "required": ["SIGNER_ENCRYPTION_KEY"] },
}
