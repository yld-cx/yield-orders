{
  "name": "yld-data",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "format": "prettier --write .",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/deploy.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@yld-cx/ethereum-protocol": "0.3.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "^24.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "wrangler": "4.151.2"
  }
}
