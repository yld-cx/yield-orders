{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yld-data",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "routes": [{ "pattern": "md.yld.cx", "custom_domain": true }],
  "cache": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yld-data",
      // Deployment provisions or reuses this named database automatically.
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "CORS_ORIGINS": "https://yld.cx",
    "RPC_URLS": "{\"ethereum\":[\"https://ethereum-rpc.publicnode.com\",\"https://gateway.tenderly.co/public/mainnet\"],\"base\":[\"https://base-rpc.publicnode.com\",\"https://mainnet.base.org\"],\"robinhood\":[\"https://robinhood-rpc.publicnode.com\",\"https://rpc.mainnet.chain.robinhood.com\"]}",
    // Optional startBlock enables backfill. Otherwise snapshot the first observed head.
    "NETWORK_CONFIG": "{}",
    "EVENT_RETENTION_MONTHS": "2",
    "CLEANUP_BATCH_SIZE": "1000",
    "TOKEN_UPSTREAM_PER_MINUTE": "20",
  },
  "secrets": {
    "required": ["COINGECKO_API_KEY"],
  },
}
